<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Next Setup - Anticipatory Skill Development - ICT Study</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@500;700&family=Crimson+Pro:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #0a0a0f;
            --bg-card: #1a1a24;
            --bg-card-hover: #242433;
            --text-primary: #e8e8ed;
            --text-secondary: #9898a8;
            --accent-bear: #ff4757;
            --accent-bull: #2ed573;
            --accent-gold: #ffa502;
            --border-color: #2a2a3a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Crimson Pro', serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.7;
            font-size: 18px;
        }

        header {
            background: linear-gradient(135deg, #1a1a24 0%, #0f0f14 100%);
            padding: 4rem 2rem 3rem;
            border-bottom: 2px solid var(--accent-gold);
            text-align: center;
        }

        header h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 3rem;
            font-weight: 700;
            color: var(--accent-gold);
            margin-bottom: 1rem;
            letter-spacing: -0.5px;
        }

        header p {
            font-size: 1.25rem;
            color: var(--text-secondary);
            max-width: 800px;
            margin: 0 auto;
        }

        nav {
            position: sticky;
            top: 0;
            background: rgba(26, 26, 36, 0.95);
            backdrop-filter: blur(10px);
            padding: 1rem 2rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            justify-content: center;
            z-index: 100;
        }

        nav a {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            color: var(--text-secondary);
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            transition: all 0.2s;
        }

        nav a:hover {
            background: var(--bg-card-hover);
            color: var(--accent-gold);
        }

        main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem 6rem;
        }

        section {
            margin-bottom: 5rem;
            scroll-margin-top: 100px;
        }

        section h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2rem;
            color: var(--accent-gold);
            margin-bottom: 2rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--border-color);
        }

        section h3 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.5rem;
            color: var(--text-primary);
            margin: 2rem 0 1rem;
        }

        .quote {
            background: var(--bg-card);
            border-left: 4px solid var(--accent-gold);
            padding: 1.5rem 2rem;
            margin: 1.5rem 0;
            border-radius: 0 8px 8px 0;
            font-style: italic;
        }

        .quote em {
            color: var(--accent-gold);
            font-style: normal;
            font-weight: 600;
        }

        .concept-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            margin: 1.5rem 0;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .concept-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(255, 165, 2, 0.1);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .card-title {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1rem;
            color: var(--accent-gold);
            font-weight: 700;
        }

        .timestamp {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-secondary);
            background: var(--bg-primary);
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
        }

        .flashcard-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .flashcard {
            background: var(--bg-card);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 2rem;
            cursor: pointer;
            transition: all 0.3s;
            min-height: 200px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        .flashcard:hover {
            border-color: var(--accent-gold);
            transform: scale(1.02);
        }

        .flashcard-question {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.1rem;
            color: var(--text-primary);
            font-weight: 600;
        }

        .flashcard-answer {
            font-style: italic;
            color: var(--text-secondary);
            margin-top: 1rem;
            display: none;
            border-top: 1px solid var(--border-color);
            padding-top: 1rem;
        }

        .flashcard.revealed .flashcard-answer {
            display: block;
        }

        .flashcard.revealed .flashcard-question::after {
            content: " ✓";
            color: var(--accent-bull);
        }

        svg {
            max-width: 100%;
            height: auto;
            margin: 2rem 0;
            background: var(--bg-card);
            padding: 2rem;
            border-radius: 12px;
        }

        ul, ol {
            margin: 1rem 0 1rem 2rem;
        }

        li {
            margin: 0.5rem 0;
            color: var(--text-primary);
        }

        strong {
            color: var(--accent-gold);
        }

        code {
            font-family: 'JetBrains Mono', monospace;
            background: var(--bg-card);
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.9em;
            color: var(--accent-bull);
        }

        .example-box {
            background: var(--bg-card);
            border: 2px solid var(--accent-bull);
            border-radius: 12px;
            padding: 1.5rem;
            margin: 1.5rem 0;
        }

        .example-box.bearish {
            border-color: var(--accent-bear);
        }

        .example-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.2rem;
            color: var(--accent-bull);
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .example-box.bearish .example-title {
            color: var(--accent-bear);
        }

        @media (max-width: 768px) {
            header { padding: 2.5rem 1.5rem 2rem; }
            header p { font-size: 1rem; }
            nav { padding: 0.75rem 1rem; gap: 0.75rem; }
            nav a { font-size: 0.75rem; padding: 0.4rem 0.75rem; }
            main { padding: 2rem 1rem 4rem; }
            section { margin-bottom: 3rem; }
            header h1 {
                font-size: 2rem;
            }

            section h2 {
                font-size: 1.5rem;
            }

            .flashcard-container {
                grid-template-columns: 1fr;
            }
        }
    
        /* Global navigation bar */
        .global-topbar {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 10px 16px;
            background: #0d0f14;
            border-bottom: 1px solid #1e2330;
            position: sticky;
            top: 0;
            z-index: 999;
        }
        .global-topbar a {
            color: #e4e8f0;
            text-decoration: none;
            font-size: 0.8rem;
            padding: 6px 12px;
            border-radius: 999px;
            border: 1px solid #1e2330;
            background: transparent;
            transition: all 0.15s ease;
        }
        .global-topbar a:hover {
            border-color: #d4a855;
            color: #d4a855;
            background: rgba(212, 168, 85, 0.12);
        }
</style>
</head>
